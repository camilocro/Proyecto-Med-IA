# Servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL (podés usar Supabase gratis)
DATABASE_URL="postgresql://usuario:password@localhost:5432/media_db"

# JWT — cambiala por una cadena larga y aleatoria
JWT_SECRET=reemplaza_esto_con_algo_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# OpenAI — obtené tu key en platform.openai.com
OPENAI_API_KEY=sk-...

# CORS — URL del frontend
FRONTEND_URL=http://localhost:3000
