# Servidor
PORT=3001
NODE_ENV=development

# Base de datos Supabase (Connect → ORMs → Prisma). Pedir los valores al equipo por privado.
DATABASE_URL=
DIRECT_URL=

# JWT — una cadena larga y aleatoria
JWT_SECRET=reemplaza_esto_con_algo_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
IA_MODO_SIMULADO=true

# CORS — URL del frontend
FRONTEND_URL=http://localhost:3000