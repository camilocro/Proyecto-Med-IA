# Servidor
PORT=3001
NODE_ENV=development

# Base de datos Supabase (Connect → ORMs → Prisma). Pedir los valores al equipo por privado.
DATABASE_URL=
DIRECT_URL=

# JWT — una cadena larga y aleatoria
JWT_SECRET=reemplaza_esto_con_algo_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
IA_MODO_SIMULADO=true

# CORS — URL del frontend
FRONTEND_URL=http://localhost:3000
# Cantidad de proxies delante del backend: 0 en local, 1 en Render
TRUST_PROXY=0

# Correo. Prioridad: BREVO_API_KEY (producción) → SMTP_USER (Gmail, local) → consola (ninguna).
# Render y Railway bloquean SMTP en sus planes gratis: en producción usar Brevo.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Debe ser el remitente verificado en Brevo (o el mismo SMTP_USER si se usa Gmail)
CORREO_REMITENTE="Med-IA <correo del proyecto>"