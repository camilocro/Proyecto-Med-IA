# Servidor
PORT=3001
NODE_ENV=development

# Base de datos Supabase (Connect → ORMs → Prisma). Pedir los valores al equipo por privado.
DATABASE_URL=
DIRECT_URL=

# JWT — una cadena larga y aleatoria
JWT_SECRET=reemplaza_esto_con_algo_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
IA_MODO_SIMULADO=true

# CORS — URL del frontend
FRONTEND_URL=http://localhost:3000


# Correo (Gmail + contraseña de aplicación). Vacío = modo desarrollo: los correos se imprimen en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="Med-IA <correo del proyecto>"